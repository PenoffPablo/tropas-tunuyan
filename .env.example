# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API). NUNCA subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu-clave-publicable

# SOLO SERVIDOR (sin prefijo NEXT_PUBLIC_): crea, bloquea y resetea las cuentas
# del personal desde el panel. Dashboard → Project Settings → API → service_role
# (o una "secret key" sb_secret_...). En Vercel: Environment Variables, no expuesta.
SUPABASE_SERVICE_ROLE_KEY=

# Datos de cobro mostrados en el POS (opcionales)
NEXT_PUBLIC_ALIAS_COBRO=TROPAS.TUNUYAN.MP
NEXT_PUBLIC_TITULAR_COBRO=Tropas Tunuyán
NEXT_PUBLIC_CVU_COBRO=
NEXT_PUBLIC_WHATSAPP_TIENDA=5492622000000

# Solo para tests/integration_check.js
TEST_BASE_URL=http://localhost:3000

# Dirección oficial del sitio (enlace "Ver catálogo" del panel y redirección de alias)
NEXT_PUBLIC_SITE_URL=https://tropastunuyan.vercel.app
# Solo producción: alias de Vercel que redirigen al dominio oficial (separados por coma)
ALIAS_REDIRIGIDOS=
